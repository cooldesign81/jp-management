rules_version = '2';

// ============================================================
// JP 스케줄 매니저 — Firestore 보안 규칙 (반포 jarada-banpo / 대치 jarada-daechi)
//
// 평촌(jarada-checkin)은 결제 매니저와 프로젝트를 같이 써서 firestore.pyeongchon.rules 를 씁니다.
// 그 파일은 이 파일에서 자동으로 만들어지니 직접 고치지 마세요 (tools 폴더에서 npm run build:rules).
//
// 누가 들어올 수 있나
//   - 직원 목록(staff 컬렉션)에 등록된 구글 계정. 관리자가 앱의 "👥 직원 관리" 화면에서 추가·삭제합니다.
//     교사를 추가할 때 이 파일을 고칠 필요는 없습니다.
//   - 최고 관리자(superAdminEmails). 직원 목록과 상관없이 항상 들어올 수 있고, 직원을 추가할 수 있습니다.
//     index.html 의 SUPER_ADMIN_EMAILS 와 같게 유지하세요.
//   - 이메일/비밀번호 계정. Firebase 콘솔에서 만든 원 공용 계정으로, 직원 목록에 없어도 교사로 들어옵니다.
//     Authentication → 설정 → 사용자 작업에서 "생성(가입) 사용 설정"을 꺼둬야 아무나 계정을 만들지 못합니다.
//
// 관리자: 최고 관리자, 또는 직원 목록에서 역할이 "관리자"인 계정.
//   완전삭제·학생 기록 이전(출결·상담 문서 삭제)과 직원 목록 관리를 할 수 있습니다.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── 누가 직원이고, 누가 관리자인가 ─────────────
    function signedIn() {
      return request.auth != null;
    }
    function provider() {
      return request.auth.token.firebase.sign_in_provider;
    }
    function email() {
      return ('email' in request.auth.token) ? request.auth.token.email.lower() : '';
    }
    function isPasswordAccount() {
      return provider() == 'password';
    }
    function isVerifiedGoogle() {
      return provider() == 'google.com' && request.auth.token.email_verified == true;
    }

    // 최고 관리자: 직원 목록이 비어 있어도 잠기지 않도록 여기에 고정
    function superAdminEmails() {
      return ['jinhyuck@gmail.com'];
    }
    function isSuperAdmin() {
      return signedIn() && isVerifiedGoogle() && email() in superAdminEmails();
    }

    // 직원 목록에서 내 문서 (문서 ID = 소문자 이메일)
    function myStaffDoc() {
      return /databases/$(database)/documents/staff/$(email());
    }
    function isListedStaff() {
      return email() != '' && exists(myStaffDoc());
    }

    function isStaff() {
      return signedIn() && (isPasswordAccount() || isSuperAdmin() || (isVerifiedGoogle() && isListedStaff()));
    }
    function isAdmin() {
      return isStaff() && (isSuperAdmin() || (isListedStaff() && get(myStaffDoc()).data.role == 'admin'));
    }

    // ───────────── 직원 목록 ─────────────
    // staff/{소문자 이메일} = { email, name, role: 'teacher' | 'admin', addedAt, addedBy, updatedAt, updatedBy }
    function validStaffDoc(staffEmail) {
      let d = request.resource.data;
      return staffEmail == staffEmail.lower()
        && d.keys().hasOnly(['email', 'name', 'role', 'addedAt', 'addedBy', 'updatedAt', 'updatedBy'])
        && d.email == staffEmail
        && d.role in ['teacher', 'admin']
        && (!('name' in d) || (d.name is string && d.name.size() <= 40));
    }
    match /staff/{staffEmail} {
      // 내 문서는 로그인만 하면 볼 수 있음 (앱이 "등록된 직원인지" 확인할 때 씀). 다른 사람 문서와 전체 목록은 직원만.
      allow get: if signedIn() && (staffEmail == email() || isStaff());
      allow list: if isStaff();
      // 추가·수정·삭제는 관리자만. 관리자가 실수로 자기 자신을 지우거나 교사로 바꿔서 잠기지 않게,
      // 자기 문서는 최고 관리자만 바꿀 수 있음.
      allow create, update: if isAdmin() && validStaffDoc(staffEmail) && (staffEmail != email() || isSuperAdmin());
      allow delete: if isAdmin() && (staffEmail != email() || isSuperAdmin());
    }

    // ───────────── 이 앱이 쓰는 컬렉션 ─────────────
    //   roster(반 배정) · photos(학생 사진) · overrides(날짜별 결석/반이동 표시) · additions(보강/신규/대체/샘플/단기 등록)
    //   manualRooms(임시 교실) · smsTemplates(문자 템플릿) · settings(SMS 설정) · listMemos(리스트 메모)
    //   dayLogs(일일보고) · makeupOpenings(보강 오픈 자리) · bookingSettings(보강 예약 설정)
    match /roster/{docId}          { allow read, write: if isStaff(); }
    match /photos/{docId}          { allow read, write: if isStaff(); }
    match /overrides/{docId}       { allow read, write: if isStaff(); }
    match /additions/{docId}       { allow read, write: if isStaff(); }
    match /manualRooms/{docId}     { allow read, write: if isStaff(); }
    match /smsTemplates/{docId}    { allow read, write: if isStaff(); }
    match /settings/{docId}        { allow read, write: if isStaff(); }
    match /listMemos/{docId}       { allow read, write: if isStaff(); }
    match /dayLogs/{docId}         { allow read, write: if isStaff(); }
    match /makeupOpenings/{docId}  { allow read, write: if isStaff(); }
    match /bookingSettings/{docId} { allow read, write: if isStaff(); }

    // 출결 기록 · 상담 기록: 읽기/추가/수정은 직원 누구나, "문서 자체를 지우는 것"은 관리자만.
    // (앱에서 문서를 지우는 작업은 완전삭제와 학생 기록 이전뿐입니다. 로그 하나를 고치거나 지우는 건 덮어쓰기라 직원도 됩니다.)
    match /attendance/{docId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /counseling/{docId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // 문자 대기열: 직원이 등록·조회·취소·수정.
    // 실제 발송 후 status 를 바꾸는 발송 서버와 연말 정산 서버는 Admin SDK 를 쓰므로 이 규칙을 거치지 않습니다.
    match /smsQueue/{docId} {
      allow read, create, update, delete: if isStaff();
    }

    // 여기에 없는 컬렉션은 전부 거부됩니다 (Firestore 기본 동작).
    // 학부모용 보강 예약 페이지가 로그인 없이 makeupOpenings / bookingSettings 를 "직접 읽는다면" 아래 두 줄을 추가하세요
    // (Cloud Function 을 통해서만 접근한다면 필요 없음):
    //   match /makeupOpenings/{docId}  { allow read: if true; }
    //   match /bookingSettings/{docId} { allow read: if true; }
  }
}

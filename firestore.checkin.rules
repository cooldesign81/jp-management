rules_version = '2';

// ============================================================
// jarada-checkin — Firestore 보안 규칙 (세 원 결제 매니저 + 옛 평촌 스케줄 매니저 데이터 보관)
//
// ※ 이 파일은 firestore.rules 에서 자동으로 만들어집니다. 직접 고치지 말고 firestore.rules 나
//   tools/build_checkin_rules.mjs 를 고친 뒤 tools 폴더에서 npm run build:rules 를 실행하세요.
//
//   - 결제 매니저가 쓰는 컬렉션(centers, userCenters): 결제 매니저 계정(아래 isPaymentManagerAccount)과 최고 관리자만
//   - 문자 대기열 smsQueue: 결제 매니저 계정 + 직원 목록 계정 (옮기기 전 화면이 남아 있어도 문자는 나가게)
//   - 옛 평촌 스케줄 매니저 데이터(반 배정·사진·출결·상담 등): 직원 목록 계정이 읽기만. 평촌 스케줄 매니저는
//     2026년 11월부터 jarada-pyeongchon 을 씁니다.
//   - 직원 설문 응답(surveyResponses): survey/jarvis.html 이 여기에 씀
// 직원 목록·최고 관리자·이메일/비밀번호 계정에 대한 설명은 firestore.rules 맨 위를 보세요.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── 누가 직원이고, 누가 관리자인가 ─────────────
    function signedIn() {
      return request.auth != null;
    }
    function provider() {
      return request.auth.token.firebase.sign_in_provider;
    }
    function email() {
      return ('email' in request.auth.token) ? request.auth.token.email.lower() : '';
    }
    function isPasswordAccount() {
      return provider() == 'password';
    }
    function isVerifiedGoogle() {
      return provider() == 'google.com' && request.auth.token.email_verified == true;
    }

    // 최고 관리자: 직원 목록이 비어 있어도 잠기지 않도록 여기에 고정
    function superAdminEmails() {
      return ['jinhyuck@gmail.com'];
    }
    function isSuperAdmin() {
      return signedIn() && isVerifiedGoogle() && email() in superAdminEmails();
    }

    // 직원 목록에서 내 문서 (문서 ID = 소문자 이메일)
    function myStaffDoc() {
      return /databases/$(database)/documents/staff/$(email());
    }
    function isListedStaff() {
      return email() != '' && exists(myStaffDoc());
    }

    // 비밀번호 계정은 직원 목록에서 로그인 방식이 'password' 로 등록된 경우만 (원 공용 계정)
    function isListedPasswordAccount() {
      return isPasswordAccount() && isListedStaff() && get(myStaffDoc()).data.get('login', 'google') == 'password';
    }
    function isStaff() {
      return signedIn() && (isSuperAdmin() || (isVerifiedGoogle() && isListedStaff()) || isListedPasswordAccount());
    }
    function isAdmin() {
      return isStaff() && (isSuperAdmin() || (isListedStaff() && get(myStaffDoc()).data.role == 'admin'));
    }

    // ───────────── 직원 목록 ─────────────
    // staff/{소문자 이메일} = { email, name, role: 'teacher' | 'admin', login?: 'google' | 'password', addedAt, addedBy, updatedAt, updatedBy }
    // login 이 없으면 구글 로그인으로 봄
    function validStaffDoc(staffEmail) {
      let d = request.resource.data;
      return staffEmail == staffEmail.lower()
        && d.keys().hasOnly(['email', 'name', 'role', 'login', 'addedAt', 'addedBy', 'updatedAt', 'updatedBy'])
        && d.email == staffEmail
        && d.role in ['teacher', 'admin']
        && (!('login' in d) || d.login in ['google', 'password'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 40));
    }
    match /staff/{staffEmail} {
      // 내 문서는 로그인만 하면 볼 수 있음 (앱이 "등록된 직원인지" 확인할 때 씀). 다른 사람 문서와 전체 목록은 직원만.
      allow get: if signedIn() && (staffEmail == email() || isStaff());
      allow list: if isStaff();
      // 추가·수정·삭제는 관리자만. 관리자가 실수로 자기 자신을 지우거나 교사로 바꿔서 잠기지 않게,
      // 자기 문서는 최고 관리자만 바꿀 수 있음.
      allow create, update: if isAdmin() && validStaffDoc(staffEmail) && (staffEmail != email() || isSuperAdmin());
      allow delete: if isAdmin() && (staffEmail != email() || isSuperAdmin());
    }

    // ───────────── 옛 평촌 스케줄 매니저 데이터 (읽기만) ─────────────
    // 평촌 스케줄 매니저는 jarada-pyeongchon 으로 옮겼습니다. 아래는 옮기기 전 데이터 보관본이라 쓰기를 막습니다.
    //   roster(반 배정) · photos(학생 사진) · overrides(날짜별 결석/반이동 표시) · additions(보강/신규/대체/샘플/단기 등록)
    //   manualRooms(임시 교실) · smsTemplates(문자 템플릿) · settings(SMS 설정) · listMemos(리스트 메모)
    //   dayLogs(일일보고) · makeupOpenings(보강 오픈 자리) · bookingSettings(보강 예약 설정)
    match /roster/{docId}          { allow read: if isStaff(); }
    match /photos/{docId}          { allow read: if isStaff(); }
    match /overrides/{docId}       { allow read: if isStaff(); }
    match /additions/{docId}       { allow read: if isStaff(); }
    match /manualRooms/{docId}     { allow read: if isStaff(); }
    match /smsTemplates/{docId}    { allow read: if isStaff(); }
    match /settings/{docId}        { allow read: if isStaff(); }
    match /listMemos/{docId}       { allow read: if isStaff(); }
    match /dayLogs/{docId}         { allow read: if isStaff(); }
    match /makeupOpenings/{docId}  { allow read: if isStaff(); }
    match /bookingSettings/{docId} { allow read: if isStaff(); }

    match /attendance/{docId} { allow read: if isStaff(); }
    match /counseling/{docId} { allow read: if isStaff(); }

    // ───────────── 결제 매니저(jarada-payment) ─────────────
    // 들어오는 방법 두 가지
    //  1) 원 공용 계정(이메일/비밀번호): 아래 계정만 결제 매니저 계정으로 봄. 모든 원을 고를 수 있음
    //     (목록은 tools/build_checkin_rules.mjs 의 PAYMENT_MANAGER_ACCOUNTS 에서 관리)
    //   jarada_boys@naver.com — 평촌
    //   jarada-banpo@naver.com — 반포
    //   jarada-daechi@naver.com — 대치
    //   jinhyuck@gmail.com — 관리자 (결제 매니저 ADMIN_EMAILS)
    //  2) 구글 로그인: JP ONE '앱에 명단 보내기'가 만든 payAccess/{이메일} 에 있는 사람. 그 문서의 centers 에 적힌 원만
    function isPaymentManagerAccount() {
      return signedIn() && isPasswordAccount() && email() in ['jarada_boys@naver.com', 'jarada-banpo@naver.com', 'jarada-daechi@naver.com', 'jinhyuck@gmail.com'];
    }
    function payDoc() {
      return /databases/$(database)/documents/payAccess/$(email());
    }
    function isPayStaff() {
      return signedIn() && isVerifiedGoogle() && email() != '' && exists(payDoc());
    }
    function payCenters() {
      return get(payDoc()).data.get('centers', []);
    }
    // payAccess: 본인 문서는 읽기만, 쓰기는 최고 관리자(JP ONE에서 명단 보내기)만
    match /payAccess/{mail} {
      allow get: if signedIn() && (mail == email() || isSuperAdmin());
      allow list, write: if isSuperAdmin();
    }

    // 문자 대기열: 스케줄 매니저 직원과 결제 매니저 계정이 같이 씀.
    // 실제 발송 후 status 를 바꾸는 발송 서버와 연말 정산 서버는 Admin SDK 를 쓰므로 이 규칙을 거치지 않습니다.
    match /smsQueue/{docId} {
      allow read, create, update, delete: if isStaff() || isPaymentManagerAccount() || isPayStaff();
    }

    // 결제 매니저가 쓰는 컬렉션. {document=**} 는 하위 컬렉션(data, weeks 등)까지 포함한다는 뜻.
    match /centers/{document=**} { allow read, write: if isPaymentManagerAccount() || isSuperAdmin(); }
    match /userCenters/{document=**} { allow read, write: if isPaymentManagerAccount() || isSuperAdmin(); }
    // 구글 로그인 직원: 자기 원(centers/{원 이름}) 자료만, 소속 원 선택(userCenters/{내 uid})은 내 원 중에서만
    match /centers/{center}/{document=**} { allow read, write: if isPayStaff() && center in payCenters(); }
    match /userCenters/{uid} {
      allow get: if isPayStaff() && uid == request.auth.uid;
      allow create, update: if isPayStaff() && uid == request.auth.uid && request.resource.data.center in payCenters();
    }

    // 업무 도구 사용 설문 (survey/jarvis.html 등): 로그인 없이 누구나 응답을 "추가"만 할 수 있고, 읽기·지우기는 관리자만.
    // 응답은 정해진 모양(설문 id · 서버 시각 · 답 묶음)만 받고, 고치기는 아무도 못 합니다. 이름·이메일은 받지 않습니다.
    function validSurveyResponse() {
      let d = request.resource.data;
      let a = d.answers;
      return d.keys().hasOnly(['survey', 'v', 'createdAt', 'answers'])
        && d.survey is string && d.survey.size() > 0 && d.survey.size() <= 40
        && d.v is int
        && d.createdAt == request.time
        && a is map && a.size() <= 40
        && (!('features' in a) || (a.features is map && a.features.size() <= 30))
        && (!('best' in a) || (a.best is list && a.best.size() <= 10))
        && (!('saved' in a) || (a.saved is list && a.saved.size() <= 20))
        && (!('savedOther' in a) || (a.savedOther is string && a.savedOther.size() <= 200))
        && (!('pain' in a) || (a.pain is string && a.pain.size() <= 2000))
        && (!('wish' in a) || (a.wish is string && a.wish.size() <= 2000))
        && (!('etc' in a) || (a.etc is string && a.etc.size() <= 2000));
    }
    match /surveyResponses/{docId} {
      allow create: if validSurveyResponse();
      allow read, delete: if isAdmin();
    }

    // 여기에 없는 컬렉션은 전부 거부됩니다 (Firestore 기본 동작).
    // 학부모용 보강 예약 페이지가 로그인 없이 makeupOpenings / bookingSettings 를 "직접 읽는다면" 아래 두 줄을 추가하세요
    // (Cloud Function 을 통해서만 접근한다면 필요 없음):
    //   match /makeupOpenings/{docId}  { allow read: if true; }
    //   match /bookingSettings/{docId} { allow read: if true; }
  }
}

rules_version = '2';

// ============================================================
// JP 스케줄 매니저 — Cloud Storage 보안 규칙 (평촌·반포·대치 공통)
//
// Storage 에는 학생 서류 사진(첫 수업 상담지·학부모 설문지)만 둡니다: studentDocs/{학생 키}/{파일 이름}
// 볼 수 있는 사람은 Firestore 규칙과 똑같이 "직원 목록(staff 컬렉션)에 등록된 계정 + 최고 관리자"뿐입니다.
// 직원인지는 같은 프로젝트의 Firestore staff 문서를 직접 확인합니다 (firestore.exists / firestore.get).
//   → 처음 게시할 때 콘솔이 "Storage 가 Firestore 를 읽을 권한"을 달라고 하면 허용을 누르세요.
// 최고 관리자 목록은 firestore.rules · index.html 의 SUPER_ADMIN_EMAILS 와 같게 유지하세요.
// 평촌(jarada-checkin)의 결제 매니저는 Storage 를 쓰지 않아서 이 파일을 그대로 게시해도 됩니다.
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function provider() {
      return request.auth.token.firebase.sign_in_provider;
    }
    function email() {
      return ('email' in request.auth.token) ? request.auth.token.email.lower() : '';
    }
    function isPasswordAccount() {
      return provider() == 'password';
    }
    function isVerifiedGoogle() {
      return provider() == 'google.com' && request.auth.token.email_verified == true;
    }
    function isSuperAdmin() {
      return signedIn() && isVerifiedGoogle() && email() in ['jinhyuck@gmail.com'];
    }
    function isListedStaff() {
      return email() != '' && firestore.exists(/databases/(default)/documents/staff/$(email()));
    }
    function isListedPasswordAccount() {
      return isPasswordAccount() && isListedStaff()
        && firestore.get(/databases/(default)/documents/staff/$(email())).data.get('login', 'google') == 'password';
    }
    function isStaff() {
      return signedIn() && (isSuperAdmin() || (isVerifiedGoogle() && isListedStaff()) || isListedPasswordAccount());
    }

    // 학생 서류 사진. 앱은 사진을 줄여서(약 0.5MB) 매번 새 파일 이름으로 올리고, 바꾸면 옛 파일을 지웁니다.
    match /studentDocs/{studentKey}/{fileName} {
      allow read: if isStaff();
      allow create: if isStaff()
        && resource == null
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaff();
    }

    // 여기에 없는 경로는 전부 거부됩니다.
  }
}
